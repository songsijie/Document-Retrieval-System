# 复制为 .env 后按需修改
# cp .env.sample .env

# 运行环境：dev | prod
APP_ENV=dev

# 应用
APP_NAME=Document Retrieval System
IS_DEBUG=true

# 服务
SVR_HOST=127.0.0.1
SVR_PORT=8000
SVR_TIMEOUT=10

# 中间件：IP 白名单，多个地址用英文逗号分隔
ALLOWED_IPS=*

# Redis（限流中间件）
CACHE_HOST=49.235.134.151
CACHE_PORT=6379
CACHE_PASSWORD=
CACHE_DB=0
CACHE_KEYPREFIX=document_retrieval

# Elasticsearch
ES_HOSTS=http://49.235.134.151:9200
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_PHYSICAL_INDEX=articles_v1
ES_INDEX=articles
ES_REQUEST_TIMEOUT=30
